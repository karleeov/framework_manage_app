{
  "name": "framework-control",
  "version": "1.0.0",
  "description": "Framework Laptop Control Panel - Fan, Power, Battery Management",
  "main": "electron/main.js",
  "type": "module",
  "scripts": {
    "dev": "node server/index.js",
    "electron:dev": "electron .",
    "electron:build": "electron-builder --win",
    "electron:build:portable": "electron-builder --win portable"
  },
  "dependencies": {
    "express": "^4.18.2",
    "systeminformation": "^5.21.20",
    "ws": "^8.14.2"
  },
  "devDependencies": {
    "electron": "^28.3.3",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.framework.control",
    "productName": "Framework Control",
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**/*",
      "server/**/*",
      "public/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources",
        "to": "resources",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        },
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ],
      "requestedExecutionLevel": "requireAdministrator"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
