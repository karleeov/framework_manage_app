{
  "name": "framework-control",
  "version": "1.0.0",
  "description": "Framework Laptop Control Panel - Fan, Power, Battery Management",
  "author": "Framework Community",
  "main": "electron/main.js",
  "type": "module",
  "scripts": {
    "dev": "node server/index.js",
    "electron:dev": "electron .",
    "electron:build": "electron-builder --win --config.directories.output=dist",
    "electron:build:portable": "electron-builder --win portable",
    "electron:build:all": "electron-builder --win nsis portable msi",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "electron-log": "^5.0.0",
    "electron-store": "^8.1.0",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "systeminformation": "^5.21.20",
    "ws": "^8.14.2"
  },
  "devDependencies": {
    "electron": "^28.3.3",
    "electron-builder": "^24.13.3",
    "jest": "^29.7.0",
    "png-to-ico": "^3.0.1",
    "sharp": "^0.34.5"
  },
  "build": {
    "asar": false,
    "appId": "com.framework.control",
    "productName": "Framework Control",
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**/*",
      "server/**/*",
      "public/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources",
        "to": "resources",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "icon": "resources/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
